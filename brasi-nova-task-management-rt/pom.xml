<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>de.brasi.nova</groupId>
		<artifactId>brasi-nova-task-management</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>brasi-nova-task-management-rt</artifactId>

	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!--
			keel-spring-framework Aggregat-Starter:
			EINE Runtime-Dependency, zieht ksf-persistence/-web/-security/-integration.
		-->
		<dependency>
			<groupId>io.keel.framework</groupId>
			<artifactId>ksf-starter</artifactId>
		</dependency>
		<!-- ksf-web explizit: Base-Controller/AssemblerEngine direkt referenziert. -->
		<dependency>
			<groupId>io.keel.framework</groupId>
			<artifactId>ksf-web</artifactId>
		</dependency>
		<!-- ksf-api explizit: Service-/Repository-/Model-/HATEOAS-/Exception-Vertraege. -->
		<dependency>
			<groupId>io.keel.framework</groupId>
			<artifactId>ksf-api</artifactId>
		</dependency>
		<dependency>
			<groupId>io.keel.framework</groupId>
			<artifactId>ksf-integration</artifactId>
		</dependency>
		<!-- ksf-security-web-starter: Anti-Spoofing, Live-Authz-SPI (Task-1-Pflicht laut Brief). -->
		<dependency>
			<groupId>io.keel.framework</groupId>
			<artifactId>ksf-security-web-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-hateoas</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>
		<!-- HikariCP/JDBC: Persistenz via KSF-JdbcTemplate -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-artemis</artifactId>
		</dependency>
		<!-- WebSocket: Due-Reminder-Push (Task-16-Scheduler-Basis). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>

		<dependency>
			<groupId>com.microsoft.sqlserver</groupId>
			<artifactId>mssql-jdbc</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Flyway: Schema-Migration (V1 = task-management-Schema).
			flyway-core: Basis-Engine. flyway-sqlserver: MSSQL-spezifische SQL-Dialekt-Unterstuetzung.
			Version via Spring-Boot-BOM. Im Normalbetrieb deaktiviert (spring.flyway.enabled=false);
			nur in ITs mit Wegwerf-DB eingeschaltet.
		-->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-sqlserver</artifactId>
		</dependency>

		<dependency>
			<groupId>de.brasi.nova</groupId>
			<artifactId>brasi-nova-task-management-api</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-config</artifactId>
		</dependency>

		<dependency>
			<groupId>io.keel.framework</groupId>
			<artifactId>ksf-test-support</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>de.brasi.nova.taskmanagement.BrasiNovaApplication</mainClass>
					<layout>JAR</layout>
					<layers>
						<enabled>true</enabled>
						<configuration>${project.basedir}/src/layers.xml</configuration>
					</layers>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!--
				Failsafe: fuehrt die Integration-Tests (*IT) im Standard-Lifecycle
				(integration-test/verify) aus. Ohne diese Bindung laufen Flyway-, REST-,
				Security-, WebSocket- und Scheduler-IT nur bei explizitem -Dtest und werden von
				`mvn verify` still uebersprungen. Version explizit gepinnt, da dieser Build keinen
				spring-boot-starter-parent erbt (sonst Maven-Default 2.12.4 -> JUnit-5-inkompatibel).
				classesDirectory=target/classes: spring-boot:repackage ersetzt das Hauptartefakt
				durch das Boot-Fat-JAR (Klassen wandern nach BOOT-INF/classes); Failsafe laeuft nach
				package und wuerde sonst dieses Fat-JAR laden -> Klassen am Root nicht ladbar.
				Gleiches Muster wie brasi-nova-production-rt.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<version>3.5.2</version>
				<configuration>
					<argLine>-XX:+EnableDynamicAgentLoading</argLine>
					<classesDirectory>${project.build.outputDirectory}</classesDirectory>
					<includes>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- Scaffold-Profile folgen in einem spaeterem Task -->
	<profiles>

		<!--
			Inkrementeller Thin-JAR-Deploy-Apparat (wie application/production/diamant):
			dependency:list schreibt die Runtime-Abhaengigkeitsliste, danach baut der
			DeploymentDistBuilder (eigenes Modul) aus dem layered Boot-JAR die
			deployment-dist (Thin-App-JAR + klassifizierte Bundles + deployment-manifest.json).
			Aufruf: mvn -Pdeployment verify -Dmaven.test.skip=true
		-->
		<profile>
			<id>deployment</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<version>${maven-dependency-plugin.version}</version>
						<executions>
							<execution>
								<id>write-runtime-dependency-list</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>list</goal>
								</goals>
								<configuration>
									<includeScope>runtime</includeScope>
									<excludeTransitive>false</excludeTransitive>
									<outputAbsoluteArtifactFilename>true</outputAbsoluteArtifactFilename>
									<outputFile>${project.build.directory}/deployment-work/runtime-dependencies.txt</outputFile>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>${exec-maven-plugin.version}</version>
						<executions>
							<execution>
								<id>build-incremental-deployment-dist</id>
								<phase>verify</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>java</executable>
									<arguments>
										<argument>-cp</argument>
										<argument>${project.parent.basedir}/brasi-nova-task-management-deployment-tools/target/classes</argument>
										<argument>de.brasi.nova.taskmanagement.deployment.DeploymentDistBuilder</argument>
										<argument>--fat-jar</argument>
										<argument>${project.build.directory}/${project.build.finalName}.jar</argument>
										<argument>--dependency-list</argument>
										<argument>${project.build.directory}/deployment-work/runtime-dependencies.txt</argument>
										<argument>--output-dir</argument>
										<argument>${project.build.directory}/deployment-dist</argument>
										<argument>--work-dir</argument>
										<argument>${project.build.directory}/deployment-work</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>generate-scaffold-api</id>
			<activation>
				<property>
					<name>generateApi</name>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>io.keel.framework</groupId>
						<artifactId>ksf-scaffold-plugin</artifactId>
						<executions>
							<execution>
								<id>generate-api</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>generate</goal>
								</goals>
								<configuration>
									<entitiesProjectPath>
										${project.basedir}/../brasi-nova-task-management-entities
									</entitiesProjectPath>
									<apiProjectPath>
										${project.basedir}/../brasi-nova-task-management-api</apiProjectPath>
									<appProjectPath>${project.basedir}</appProjectPath>
									<generationMode>API_ONLY</generationMode>
									<rootPackage>de.brasi.nova.taskmanagement</rootPackage>
									<entitiesPackage>
										de.brasi.nova.taskmanagement.entity</entitiesPackage>
									<!--
										Nur Persistenz-/Modell-Targets (arch-v2 §7):
										Controller, Hateoas, Assembler, LinkSpec werden NICHT erzeugt.
										Die gesamte REST-Oberflaeche sind hand-geschriebene Facade-Controller.
										<all>true</all> waehlt ALLE gefundenen Entities aus; die explizite
										<targets>-Liste begrenzt die erzeugten ARTEFAKT-Typen auf diese Auswahl.
									-->
									<targets>
										<target>Repository</target>
										<target>Model</target>
										<target>Validator</target>
										<target>QClass</target>
										<target>QueryProvider</target>
										<target>ServiceProviders</target>
										<target>Summary</target>
									</targets>
									<all>true</all>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>generate-scaffold-app</id>
			<activation>
				<property>
					<name>generateApp</name>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>io.keel.framework</groupId>
						<artifactId>ksf-scaffold-plugin</artifactId>

						<dependencies>
							<dependency>
								<groupId>de.brasi.nova</groupId>
								<artifactId>brasi-nova-task-management-api</artifactId>
								<version>${project.version}</version>
							</dependency>
						</dependencies>

						<executions>
							<execution>
								<id>create-final-classes</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>generate</goal>
								</goals>
								<configuration>
									<entitiesProjectPath>
										${project.basedir}/../brasi-nova-task-management-entities
									</entitiesProjectPath>
									<apiProjectPath>
										${project.basedir}/../brasi-nova-task-management-api</apiProjectPath>
									<appProjectPath>${project.basedir}</appProjectPath>
									<generationMode>APP_ONLY_IF_NOT_EXISTS</generationMode>
									<rootPackage>de.brasi.nova.taskmanagement</rootPackage>
									<entitiesPackage>
										de.brasi.nova.taskmanagement.entity</entitiesPackage>
									<!--
										Konsistente Target-Liste zum generate-scaffold-api-Profil:
										nur Persistenz-/Modell-Targets, keine Web-Layer-Artefakte.
										<all>true</all> waehlt ALLE gefundenen Entities aus; die explizite
										<targets>-Liste begrenzt die erzeugten ARTEFAKT-Typen auf diese Auswahl.
									-->
									<targets>
										<target>Repository</target>
										<target>Model</target>
										<target>Validator</target>
										<target>QClass</target>
										<target>QueryProvider</target>
										<target>ServiceProviders</target>
										<target>Summary</target>
									</targets>
									<all>true</all>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

	</profiles>
</project>
